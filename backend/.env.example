NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://postgres:password@localhost:5432/linkium

# Comma-separated list of allowed frontend origins for CORS & Origin checks
FRONTEND_URL=http://localhost:3000,http://localhost:5173
APP_BASE_URL=http://localhost:3000

# Minimum 32-character secret for session-bound CSRF token derivation (required in production)
SESSION_SECRET=
COOKIE_SAME_SITE=lax

# Email configuration: "console" for local dev/test, "resend" for production
EMAIL_PROVIDER=console
EMAIL_FROM=LINKIUM <no-reply@example.com>
EMAIL_API_KEY=

# Authentication & token lifetimes
SESSION_MAX_AGE_DAYS=7
VERIFICATION_TOKEN_EXPIRY_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30
INVITATION_EXPIRY_DAYS=7

# Rate limiting configuration
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_EMAIL_MAX=5

LOG_LEVEL=info
